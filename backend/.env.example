# ==============================================================================
# Supabase Auth Configuration
# ==============================================================================
# Found in Supabase Dashboard -> Project Settings -> API (or Data API / API Keys).
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me

# ==============================================================================
# Supabase PostgreSQL Connection Strings for Prisma
# ==============================================================================
# Copy this file to `.env` in `backend/` and replace the placeholders with your
# real Supabase credentials. Never commit `.env` to version control.
#
# Where to find these values in Supabase:
#   1. Open your Supabase project dashboard.
#   2. Click "Connect" at the top of the dashboard (or go to
#      Project Settings -> Database -> Connection string).
#   3. Select "URI" (or the "Prisma" tab) to inspect the connection strings.
#   4. Replace [PROJECT-REF], [REGION], and [YOUR-PASSWORD] with your project's
#      actual values (URL-encode special characters in the password if needed).

# Pooled connection via Supavisor (Transaction mode, port 6543).
# Used by Prisma Client at runtime; `?pgbouncer=true` disables prepared statements.
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"

# Direct connection (port 5432).
# Used by Prisma CLI (`prisma db push`, `prisma migrate`) to bypass the pooler.
DIRECT_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres"
